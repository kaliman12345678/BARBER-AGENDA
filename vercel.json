{
  "outputDirectory": "client/dist",
  "functions": {
    "api/*.js": {
      "includeFiles": "client/dist/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/b/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/((?!assets|favicon\\.png|apple-touch-icon\\.png|manifest\\.json).*)",
      "destination": "/api/index.js"
    }
  ]
}
